{
  "id": "filevault",
  "name": "FileVault",
  "summary": "Turns on FileVault with an individual recovery key escrowed to Jamf Pro, enforced by a login policy on the chosen scope.",
  "category": "Security",
  "version": "1.0.0",
  "requires": [
    "foundation"
  ],
  "conflicts": [],
  "products": [
    "jamf-pro"
  ],
  "minJamfProVersion": "11.31.0",
  "permissions": [
    "disk-encryption-configurations:create",
    "disk-encryption-configurations:read",
    "disk-encryption-configurations:update",
    "disk-encryption-configurations:delete",
    "policies:create",
    "policies:read",
    "policies:update",
    "policies:delete"
  ],
  "risk": "medium",
  "alwaysOn": false,
  "scope": {
    "kind": "jamfProGroup",
    "variable": "scope_jamf_pro_group_id",
    "default": "pilot"
  },
  "settings": [
    {
      "key": "auth_restart",
      "title": "Authenticated restart",
      "type": "bool",
      "default": "false",
      "required": false,
      "description": "Restart straight into the user session after enabling FileVault (Macs with T2 or Apple silicon).",
      "section": "Behaviour"
    }
  ],
  "objectsCreated": [
    "1 disk encryption configuration (individual key, escrowed)",
    "1 policy (enable FileVault at login)"
  ],
  "acceptsCategory": true,
  "driftBindings": [
    {
      "resourceType": "jamfplatform_pro_policy",
      "fieldPath": "disk_encryption.auth_restart",
      "settingKey": "auth_restart"
    }
  ]
}